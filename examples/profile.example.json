    "market <-> price oracle",
    "collateral accounting <-> share token",
    "liquidator <-> position owner"
  ],
  "roles": ["depositor", "borrower", "liquidator", "owner", "attacker"],
  "external_deps": ["Chainlink-style price feed", "ERC20 collateral token", "interest rate model"],
  "notes": "Example profile used by the README and the acceptance tests."
}

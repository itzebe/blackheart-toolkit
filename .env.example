# BLACKHEART environment variables — names and descriptions only.
#
# Copy to `.env` and fill in what you need, or export these in your shell.
# `.env` is git-ignored. NEVER commit a real value.
#
# Nothing here is required for the Solidity engines to run: `blackheart engines
# bootstrap` and `engines doctor` need no key. The provider keys below are only
# for the optional reviewer model and the agentic engines.

# --------------------------------------------------------------------------- #
# Chain access (optional)
# --------------------------------------------------------------------------- #
# An Ethereum JSON-RPC endpoint. Honoured verbatim when set; otherwise
# `blackheart.rpc.resolve_rpc` probes the keyless chainid.network registry and
# public fallbacks. Use a private endpoint for anything sustained.
BLACKHEART_ETH_RPC=

# --------------------------------------------------------------------------- #
# Reviewer model (optional — never a hard dependency)
# --------------------------------------------------------------------------- #
# A comma-separated provider allow-list, e.g. "groq,gemini". When unset, every
# configured provider is considered.
BLACKHEART_PROVIDERS=

# One key per provider you actually use. A present key is only *configured*; it
# becomes *available* only after a successful liveness probe. `blackheart models
# reviewer` shows the resolution without failing when none is set.
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
KILO_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=
ZAI_API_KEY=

# --------------------------------------------------------------------------- #
# Agentic engines (optional, all disabled unless configured)
# --------------------------------------------------------------------------- #
# PentAGI is an external service you run yourself; BLACKHEART only talks to it.
PENTAGI_BASE_URL=
PENTAGI_API_TOKEN=

# --------------------------------------------------------------------------- #
# Triggers (optional)
# --------------------------------------------------------------------------- #
# HMAC secret for the webhook trigger receiver. Without it, webhook delivery is
# refused; manual and recurring triggers still work.
BLACKHEART_TRIGGER_SECRET=

# --------------------------------------------------------------------------- #
# Toolchain overrides (optional)
# --------------------------------------------------------------------------- #
# Where an isolated venv tool lives, if not the default ~/.blackheart/venvs/<name>.
BLACKHEART_MYTHRIL_VENV=
